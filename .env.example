# Copy to .env (git-ignored). Read by docker-compose and scripts/apply_preset.py.

# --- pipeline keyword stage (any OpenAI-compatible endpoint) ---
# Leave blank to reuse GEMINI_API_KEY (free tier) for `--keywords llm`. Only fill these to use a different provider.
KEYWORD_LLM_API_KEY=
# KEYWORD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# KEYWORD_LLM_MODEL=gemini-3.6-flash

# --- MoneyPrinterTurbo provider keys (substituted into config/mpt-config.toml) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Free key from api.data.gov (Smithsonian Open Access source)
SMITHSONIAN_API_KEY=
# Free access key from unsplash.com/developers (Unsplash source; demo keys allow 50 requests an hour)
UNSPLASH_ACCESS_KEY=
# Free key from https://pro.dp.la/developers (Digital Public Library of America source)
DPLA_API_KEY=
# Free key from https://www.flickr.com/services/apps/create/apply (Flickr source, incl. Flickr Commons)
FLICKR_API_KEY=
# Free key from https://pro.europeana.eu/get-api (Europeana source)
EUROPEANA_API_KEY=
# No key needed for: Wikipedia, Wikimedia Commons, NASA, Internet Archive, Library of Congress,
# Chronicling America, Openverse, URL list

# Pexels images/video for the pipeline's own source (same key as above is fine)
# SOURCES_USER_AGENT=hitl-shorts-pipeline/0.1 (you@example.com)   # Wikipedia asks for a contact

# Optional: protect the MoneyPrinterTurbo API (must match [app] api_key in its config)
# MPT_API_KEY=

# Optional: use a different key/model for semantic relevance scoring (docs/SCORING.md) than the keyword model.
# Leave unset to reuse GEMINI_API_KEY (same free tier). Set [relevance] enabled = false in config/pipeline.toml
# to turn this off entirely and use only free, offline keyword-matching.
RELEVANCE_LLM_API_KEY=

# Optional: a backup LLM provider (docs/LOGGING.md "LLM fallback provider"). When Gemini's free tier is still
# down after its own retries, every LLM call -- keywords, relevance scoring, script writing, and
# scripts/make_keywords.py -- is retried once against this provider before giving up. Off until this is set.
# Groq (api.groq.com) is a DIFFERENT company from xAI's Grok, easy to mix up -- Groq has a genuine free
# developer tier (no credit card): get a key at https://console.groq.com/keys. See [llm_fallback] in
# config/pipeline.toml for the provider/model/base_url this points at by default.
GROQ_API_KEY=
